# Build mode: "demo" (fictitious data in the browser, mock AI) or "api" (phase 2/3)
VITE_APP_MODE=demo

# Phase 2/3 only — used by the API (api/), never by the frontend.
# Put real values in .env.local / api/local.settings.json (both gitignored).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
